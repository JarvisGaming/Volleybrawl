<!DOCTYPE html>
<html>
<head>
  <title>Volleybrawl - Play</title>
  <link href="/reset.css" rel="stylesheet">
  <link href="/style.css" rel="stylesheet">

  <script src="/scripts/jquery.min.js"></script>
  <script src="/socket.io/socket.io.js"></script>
  <script src="/scripts/play.js" type="module" defer></script>
</head>
<body data-bootstrap-user="<%- encodeURIComponent(JSON.stringify(user)) %>">
  <!-- The connect page -->
  <div id="connect-page">
    <div class="row">
      <div class="col">
        <div class="title">Connecting...</div>
        <div id="connect-message" class="message"></div>
      </div>
    </div>
  </div>

  <!-- The room listing page -->
  <div id="room-listing-page" style="display: none">
    <div class="title">Room Listing</div>
    <div class="message">
      Signed in as <b id="player-display-name"></b>
      (<button id="back-home-button" type="button" style="padding:6px 10px;font-size:14px;font-weight:normal;">Home</button>)
    </div>
    <div id="room-message" class="message"></div>
    <button type="button" id="create-room-button">Create New Room</button>

    <div id="room-listing"></div>

    <template id="room-template">
      <div class="room" data-roomid="">
        <div class="player1-name"></div>
        <b>VS</b>
        <div class="player2-name"></div>
        <div>
          <button type="button" data-roomid="" class="join-room-button">Join</button>
          <button type="button" data-roomid="" class="leave-room-button">Leave</button>
          <button type="button" data-roomid="" class="ready-button">Ready</button>
        </div>
      </div>
    </template>
  </div>

  <!-- The game page -->
  <div id="game-page" style="display: none">
    <div id="game-score" class="subtitle">
      <span id="player1-name-label" class="left-name-score-gap">(Player 1)</span><span id="player1-score">0</span>
      <span class="score-separator">-</span>
      <span id="player2-score">0</span><span id="player2-name-label" class="right-name-score-gap">(Player 2)</span>
    </div>
    <div id="game-message" class="message"></div>

    <div id="game-buttons" style="display: none">
      <button id="restart-game-button" type="button">Restart Game</button>
      <button id="return-to-lobby-button" type="button">Return to Lobby</button>
      <button id="back-home-from-game-button" type="button">Back to Home</button>
    </div>

    <div id="game-canvas-wrapper">
      <canvas id="game-canvas" width="800" height="600"></canvas>

      <div id="game-over-panel" style="display:none;">
        <div id="game-over-title" class="subtitle">Game Over</div>
        <div class="game-over-sections">
          <div class="game-over-card">
            <div class="game-over-heading">Ranking (by Score)</div>
            <ol id="ranking-list"></ol>
          </div>
          <div class="game-over-card">
            <div class="game-over-heading">Player Statistics</div>
            <table id="stats-table">
              <thead>
                <tr>
                  <th>Player</th>
                  <th>Score</th>
                  <th>Jumps</th>
                  <th>Successful Smacks</th>
                </tr>
              </thead>
              <tbody id="stats-table-body"></tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>

</body>
</html>

